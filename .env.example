# Required only for photos stored in Supabase Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
# For legacy projects only, SUPABASE_SERVICE_ROLE_KEY is also supported.
SUPABASE_STORAGE_BUCKET=biomant-equipo-fotos

# Optional extra inboxes for priority tecnovigilance notices (comma-separated).
# Administrator accounts already receive these notices when SMTP is configured.
TECNOVIGILANCIA_EMAILS=responsable.tecnovigilancia@clinica.example
